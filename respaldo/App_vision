class VideoThread(QThread):
    change_pixmap_signal = pyqtSignal(np.ndarray)
    data_signal = pyqtSignal(dict)

    def __init__(self):
        super().__init__()
        self.running = True
        self.cap_index = CAMARA_POR_DEFECTO
        self.debug = False
        self.roi_w = ROI_ANCHO_INICIAL
        self.roi_h = ROI_ALTO_INICIAL
        self.origen_x = COORDENADAS_ORIGEN_X
        self.origen_y = COORDENADAS_ORIGEN_Y
        self.factor_luz_offset = 0

    def set_luz_offset(self, valor):
        self.factor_luz_offset = valor

    def set_roi_size(self, w, h):
        self.roi_w = w
        self.roi_h = h

    def set_origin(self, x, y):
        self.origen_x = x
        self.origen_y = y

    def analizar_roi_color(self, frame, x1, y1, x2, y2):
        """
        Analyzes the ROI area, ignores the blue conveyor belt,
        and determines the dominant color using the mode (most frequent value).
        """
        roi = frame[y1:y2, x1:x2]
        if roi.size == 0:
            return "N/A", 0, 0, 0

        hsv_roi = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
        lower_blue = np.array([85, 50, 50])
        upper_blue = np.array([130, 255, 255])
        mask_blue = cv2.inRange(hsv_roi, lower_blue, upper_blue)
        mask_objeto = cv2.bitwise_not(mask_blue)
        kernel = np.ones((5,5), np.uint8)
        mask_objeto = cv2.morphologyEx(mask_objeto, cv2.MORPH_OPEN, kernel)

        if np.sum(mask_objeto > 0) < 1000:
            return "N/A", 0, 0, 0

        # Use the mask within calcHist to avoid flattening the array, which causes OpenCV crashes
        # Hue (0-179)
        hist_h = cv2.calcHist([hsv_roi], [0], mask_objeto, [180], [0, 180])
        h = np.argmax(hist_h)

        # Saturation (0-255)
        hist_s = cv2.calcHist([hsv_roi], [1], mask_objeto, [256], [0, 256])
        s = np.argmax(hist_s)

        # Value (0-255)
        hist_v = cv2.calcHist([hsv_roi], [2], mask_objeto, [256], [0, 256])
        v = np.argmax(hist_v)

        if s < 50: color = "Blanco/Gris"
        elif v < 40: color = "Negro"
        elif (h < 15 or h > 145) and v > 150 and s < 180: color = "Rosa"
        elif (h <= 10 or h > 113) and v <= 255: color = "Marron"
        elif 85 <= h < 130: color = "Azul"
        else: color = "Desconocido"

        return color, h, s, v

    def procesar(self, frame):
        datos = {"H": 0, "S": 0, "V": 0, "Color": "N/A", "Tipo": "N/A"}

        frame = cv2.convertScaleAbs(frame, alpha=ALPHA_LUMINOSIDAD_INICIAL, beta=BETA_LUMINOSIDAD_INICIAL)
        if self.factor_luz_offset != 0:
            alpha = 1.0 + (self.factor_luz_offset * 0.08 if self.factor_luz_offset > 0 else self.factor_luz_offset * 0.05)
            beta = self.factor_luz_offset * (2 if self.factor_luz_offset > 0 else 3)
            frame = cv2.convertScaleAbs(frame, alpha=alpha, beta=beta)

        b, g, r = cv2.split(frame)
        frame = cv2.merge([cv2.multiply(b, B_GAIN), cv2.multiply(g, G_GAIN), cv2.multiply(r, R_GAIN)])
        frame = np.clip(frame, 0, 255).astype(np.uint8)

        alto, ancho, _ = frame.shape
        fcx, fcy = ancho // 2, alto // 2
        x1, y1 = max(0, fcx - self.roi_w // 2), max(0, fcy - self.roi_h // 2)
        x2, y2 = min(ancho, fcx + self.roi_w // 2), min(alto, fcy + self.roi_h // 2)

        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 255), 2)
        cv2.putText(frame, "SISTEMA DETECCION COLOR", (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

        color, h, s, v = self.analizar_roi_color(frame, x1, y1, x2, y2)

        if color != "N/A":
            tipo = "Chocolate" if color == "Marron" else ("Frutilla" if color == "Rosa" else "Otro")
            datos = {
                "H": h,
                "S": s,
                "V": v,
                "Color": color,
                "Tipo": tipo
            }
            cv2.putText(frame, f"Color: {color} | Tipo: {tipo}", (x1, y2 + 25), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
            cv2.putText(frame, f"HSV: {h},{s},{v}", (x1, y2 + 45), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        cv2.circle(frame, (self.origen_x, self.origen_y), 5, (0, 0, 255), 2)

        if self.debug:
            roi_crop = frame[y1:y2, x1:x2]
            hsv_roi = cv2.cvtColor(roi_crop, cv2.COLOR_BGR2HSV)
            blue_mask = cv2.inRange(hsv_roi, np.array([85, 50, 50]), np.array([130, 255, 255]))
            obj_mask = cv2.bitwise_not(blue_mask)
            debug_img = np.vstack([
                cv2.resize(frame, (320, 240)),
                cv2.resize(cv2.cvtColor(obj_mask, cv2.COLOR_GRAY2BGR), (320, 240))
            ])
            return debug_img, datos

        return frame, datos

    def restart_camera(self, new_cam_id):
        self.running = False
        self.wait()
        self.cap_index = new_cam_id
        self.running = True
        self.start()

    def run(self):
        try:
            self.camara_mars = CamaraMarsIndustrial()
            if not self.camara_mars.inicializar():
                print(f"ERROR: No se pudo acceder a la cámara")
                return
            contador_frames = 0
            while self.running:
                ret, frame_raw = self.camara_mars.obtener_frame()
                if not ret: break
                contador_frames += 1
                if contador_frames % FRAME_SKIP != 0:
                    del frame_raw
                    continue
                frame = cv2.resize(frame_raw, (640, 480), interpolation=cv2.INTER_AREA)
                del frame_raw
                frame_procesado, datos = self.procesar(frame)
                self.change_pixmap_signal.emit(frame_procesado)
                self.data_signal.emit(datos)
                del frame
                del frame_procesado
            self.camara_mars.liberar()
        except Exception as e:
            print(f"Error al acceder a la cámara: {e}")

class ModbusThread(QThread):
    connection_result = pyqtSignal(bool)
    robot_ready_signal = pyqtSignal(bool)

    def __init__(self, modbus_queue):
        super().__init__()
        self.client = None
        self.ip = "192.168.2.17"
        self.port = 502
        self.is_running = False
        self.modbus_queue = modbus_queue

        self.GV_DETECTOR = 0 # GV0: Detector de caja (1 = detectada)
        self.GV_COLOR = 2 # GV1: Color detectado (1 = rosa, 2 = marrón)

        self.prev_gv1 = 0
        self.auto_mode = True

    def set_config(self, ip, port):
        self.ip = ip
        self.port = port

    def set_auto_mode(self, enabled):
        self.auto_mode = enabled

    def _write_float_gv(self, gv_reg, valor):
        """Writes a 32-bit float to the robot's GV variable."""
        try:
            raw_bytes = struct.pack('<f', float(valor))
            low = struct.unpack('<H', raw_bytes[0:2])[0]
            high = struct.unpack('<H', raw_bytes[2:4])[0]
            # write_multiple_registers takes a list of 16-bit registers
            self.client.write_multiple_registers(gv_reg, [low, high])
            return True
        except Exception as e:
            print(f"Modbus Write Error: {e}")
            return False

    def run(self):
        try:
            self.client = ModbusClient(host=self.ip, port=self.port, unit_id=1, auto_open=True)
            if self.client.open():
                self.is_running = True
                self.connection_result.emit(True)
                while self.is_running:

                    # Read GV0 (We read 2 registers because GV is 32-bit float)
                    regs = self.client.read_holding_registers(self.GV_DETECTOR, 2)
                    if regs and len(regs) == 2:
                        # Convert the two 16-bit registers back to float to check the value
                        raw_bytes = struct.pack('<HH', regs[0], regs[1])
                        gv0_val = struct.unpack('<f', raw_bytes)[0]

                        # Signal the HMI if an object is detected (GV1 == 1)
                        is_object_present = (gv0_val == 1.0)
                        self.robot_ready_signal.emit(is_object_present)

                        # RISING EDGE DETECTION: Only send when GV1 changes from 0 to 1
                        if is_object_present and self.prev_gv1 == 0:
                            if self.auto_mode:
                                datos_recientes = None
                                while not self.modbus_queue.empty():
                                    try:
                                        datos_recientes = self.modbus_queue.get_nowait()
                                    except queue.Empty:
                                        break

                                if datos_recientes:
                                    self._enviar_resultado_color(datos_recientes)

                        self.prev_gv1 = 1 if is_object_present else 0

                    self.msleep(50)
                    
            else:
                self.connection_result.emit(False)
        except Exception as e:
            print(f"Error en bucle Modbus: {e}")
            self.connection_result.emit(False)

    def _enviar_resultado_color(self, datos):
        color = datos.get("Color", "N/A")
        val_to_send = 0.0 # Default: Unknown
        if color == "Rosa":
            val_to_send = 1.0
        elif color == "Marron":
            val_to_send = 2.0

        if self._write_float_gv(self.GV_COLOR, val_to_send):
            print(f"[MODBUS AUTO] GV0 objeto detectado -> Enviando {color} (GV1={val_to_send})")

    def manual_send_color(self, val):
        """Manually send a float value to GV1 for testing"""
        if self.client and self.client.is_open:
            if self._write_float_gv(self.GV_COLOR, float(val)):
                print(f"[MODBUS MANUAL] Enviando GV1={val}")

    def stop(self):
        self.is_running = False
        if self.client:
            self.client.close()
        self.quit()

