from collections import deque

CAMARA_POR_DEFECTO = 1  # Aquí pones el ID que quieras (0, 1, 2...)
COORDENADAS_ORIGEN_X = 100 #Coordenada inicial de origen (0,0) en px (tanto para X como para Y)
COORDENADAS_ORIGEN_Y = 100 #Coordenada inicial de origen (0,0) en px (tanto para X como para Y)
FACTOR_PX_MM = 1 #Factor de conversion inicial de px a mm (ajustable desde la HMI)
MODELO_YOLO = "runs/detect/entrenamiento_frutas_V2/weights/best.pt"

# Estos valores son los "controles de tono".
# 1.0 es el valor neutro. 
# Si se ve naranja, baja el rojo (r_gain) y sube el azul (b_gain).
R_GAIN = 0.85  
G_GAIN = 0.88  
B_GAIN = 1.3  

DISTANCIA_CENTROS = 60 # Distancia máxima en píxeles para considerar que la detección de la IA y el contorno son el mismo objeto (ajustable)

PROMEDIO_MEDIDAS = 15 # Número de frames a promediar

PROMEDIO_MEDIDAS_MODBUS = 10 # Número de medidas a promediar antes de enviar al PLC (puede ser igual o diferente al de visión)

# --- CLASE PARA EL HILO DE VISIÓN ---
class VideoThread(QThread):
    #Creamos una señal personalizada para enviar el frame procesado al hilo principal
    change_pixmap_signal = pyqtSignal(np.ndarray)
    #Creamos otra señal para enviar datos de coordenadas, ángulo y color al hilo principal
    data_signal = pyqtSignal(dict)
    #Creamos una señal para enviar el frame al hilo de IA
    enviar_a_ia_signal = pyqtSignal(np.ndarray)

    def __init__(self):

        #Seccion de HMI
        super().__init__()
        self.running = True
        self.cap_index = CAMARA_POR_DEFECTO  # Valor por defecto inicial para la cámara

        #Seccion de Vision
        self.px_to_mm = FACTOR_PX_MM #Factor de conversion de px a mm

        # Coordenadas iniciales del rectángulo de análisis: (x, y, ancho, alto)
        self.roi_w = 300
        self.roi_h = 300

        #Origen de coordenadas para el sistema de referencia (0,0)
        self.origen_x = COORDENADAS_ORIGEN_X
        self.origen_y = COORDENADAS_ORIGEN_Y

        #Variable para almacenar la última lista de detecciones de la IA
        self.ultima_lista_ia = []

        self.ventana_promedio = PROMEDIO_MEDIDAS # Número de frames a promediar
        self.objetos_historial = {} # Diccionario: {id: {'x': deque, 'y': deque, 'ang': deque, 'frames_visto': int}}
        self.next_id = 0
        self.distancia_max = 50 # Píxeles máximos que se puede mover un objeto entre frames
        self.historial_x = deque(maxlen=self.ventana_promedio)
        self.historial_y = deque(maxlen=self.ventana_promedio)
        self.historial_angulo = deque(maxlen=self.ventana_promedio)
        self.historial_box = deque(maxlen=self.ventana_promedio)

    def actualizar_lista_ia(self, lista):
        """Actualiza el buzón con las detecciones más recientes de la IA"""
        self.ultima_lista_ia = lista

    def set_calibration(self, valor):
        self.px_to_mm = valor

    def set_roi_size(self, w, h):
        self.roi_w = w
        self.roi_h = h

    def set_origin(self, x, y):
        self.origen_x = x
        self.origen_y = y

    def detectar_color(self, frame, cnt):
        hsv_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        
        # Crear máscara del contorno
        mask = np.zeros(frame.shape[:2], dtype=np.uint8)
        cv2.drawContours(mask, [cnt], 0, 255, -1)
        
        # Extraer píxeles HSV dentro de la máscara
        pixels_hsv = hsv_frame[mask == 255]
        
        if len(pixels_hsv) == 0:
            return "Desconocido"
        
        # Histograma del Hue y encontrar el pico más frecuente
        hist = cv2.calcHist([pixels_hsv], [0], None, [180], [0, 180])
        hue_mode = np.argmax(hist)  # Hue más frecuente
        
        # Promedios de Saturation y Value
        sat = int(np.mean(pixels_hsv[:, 1]))
        val = int(np.mean(pixels_hsv[:, 2]))
    
        # Lógica de rangos (igual)
        if sat < 50: return "Blanco/Gris"
        if val < 40: return "Negro"
        
        if hue_mode < 10 or hue_mode > 160: return "Rojo"
        elif 10 <= hue_mode < 25: return "Naranja"
        elif 25 <= hue_mode < 32: return "Amarillo"
        elif 30 <= hue_mode < 85: return "Verde"
        elif 85 <= hue_mode < 130: return "Azul"
        elif 130 <= hue_mode <= 160: return "Violeta"

        return "Desconocido"
    
    def procesar(self, frame):

        #Inicializamos un diccionario para enviar los datos al hilo principal (HMI)
        datos={"X_mm": 0, "Y_mm": 0, "Angulo": 0, "Color": "N/A", "Tipo": "N/A"}

        '''
        # --- CAPA A: DIAGNÓSTICO DE IA ---
        # Si la IA detectó algo, lo dibujamos aunque ingeniería falle
        if hasattr(self, 'ultima_lista_ia') and self.ultima_lista_ia:
            for det in self.ultima_lista_ia:
                ix, iy = det["centro"]
                # Dibujamos un círculo pequeño donde la IA dice que hay algo
                cv2.circle(frame, (ix, iy), 20, (255, 255, 0), 2)
                cv2.putText(frame, f"IA detecto: {det['nombre']}", (ix, iy - 25), 
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
        '''   

        frame_inicial = frame.copy() # Guardamos el frame original para dibujar los resultados al final

        # 1. Pipeline de procesamiento con visualización
        # -------BLOQUE DE CORRECCIÓN DE COLOR--------------
        # Dividimos los canales, aplicamos ganancia y unimos
        b, g, r = cv2.split(frame)
        b = cv2.multiply(b, B_GAIN)
        g = cv2.multiply(g, G_GAIN)
        r = cv2.multiply(r, R_GAIN)
        
        frame_corregido = cv2.merge([b, g, r])
        frame_corregido = np.clip(frame_corregido, 0, 255).astype(np.uint8)
        ganancias=frame_corregido.copy() # Guardamos el frame corregido para mostrarlo en el mosaico
        frame = frame_corregido
        # --------------------------------------------------

        #cv2.imshow("Original", frame)

        #gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        #cv2.imshow("1. Escala de Grises", gray)

        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        h_canal, s_canal, v_canal = cv2.split(hsv)
        #cv2.imshow("Saturacion", s_canal)
        #cv2.imshow("Valor", v_canal)

        #clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
        #v_canal_high_contrast = clahe.apply(v_canal)
        #cv2.imshow("Clahe", s_canal_high_contrast)
        
        blurred = cv2.GaussianBlur(v_canal, (7, 7), 0)
        #cv2.imshow("2. Desenfoque (Blur)", blurred)

        #s_limpio = cv2.medianBlur(s_canal, 5)
        #cv2.imshow("2. Mediana (Blur)", s_limpio)

        edged = cv2.Canny(blurred, 50, 150)
        canny=edged

        kernel = np.ones((3, 3), np.uint8)
        #cv2.imshow("Canny", edged)
        edged = cv2.dilate(edged, kernel, iterations=4)
        dilate=edged
        #cv2.imshow("dilate", edged)
        edged = cv2.erode(edged, kernel, iterations=3)
        erode=edged

        #cv2.imshow("3. Bordes (Canny)", edged)

        # 2. Referencia de Origen (Circulo en origen)
        cv2.circle(frame, (self.origen_x, self.origen_y), 5, (0, 0, 255), 2)
        #cv2.putText(frame, "(0,0)", (self.origen_x - 30, self.origen_y + 3), 
        #          cv2.FONT_HERSHEY_SIMPLEX, 0.3, (255, 255, 0), 1)

        #Roi de analisis (Rectangulo)
        # Calculamos el centro de la imagen real
        alto, ancho, _ = frame.shape
        fcx, fcy = ancho // 2, alto // 2

        # Calculamos las esquinas del ROI (creciendo desde el centro)
        x1 = max(0, fcx - self.roi_w // 2)
        y1 = max(0, fcy - self.roi_h // 2)
        x2 = min(ancho, fcx + self.roi_w // 2)
        y2 = min(alto, fcy + self.roi_h // 2)

        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 255), 2)
        cv2.putText(frame, "ZONA DE ANALISIS", (x1, y1 - 10), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

        # 3. Detección de contornos
        contours, _ = cv2.findContours(edged, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        centros_actuales = []

        for cnt in contours:
            if cv2.contourArea(cnt) < 1000: # Filtro de tamaño
                continue

            M = cv2.moments(cnt)
            if M["m00"] != 0:
                #Centroide del contorno desde el origen del frame
                cx = int(M["m10"] / M["m00"])
                cy = int(M["m01"] / M["m00"])

                # FILTRAR: Solo procesar si está dentro del ROI
                if not (x1 <= cx <= x1 + self.roi_w and 
                        y1 <= cy <= y1 + self.roi_h):
                    continue
                
                rect = cv2.minAreaRect(cnt) #Minima area rectangular en la que se puede inscribir el contorno
                box=cv2.boxPoints(rect) #Obtenemos los 4 puntos del rectángulo mínimo
                (_, _), (w, h), angulo = rect #Obtenemos el ángulo de rotación del rectángulo mínimo (centro xy)(ancho, alto)(angulo)
                angulo = abs(angulo) #El angulo va desde el punto mas bajo en sentido antohorario

                centros_actuales.append({
                    'x': cx, 'y': cy, 'ang': abs(angulo), 
                    'cnt': cnt, 'box': box
                })
            
        # --- ASIGNACIÓN DE ID Y PROMEDIO INDEPENDIENTE ---
        nuevos_historiales = {}
                
        for obj in centros_actuales:
            match_id = None
            distancia_minima = self.distancia_max

            # Buscar el ID más cercano en el historial previo
            for obj_id, datos in self.objetos_historial.items():
                dist = np.sqrt((obj['x'] - datos['x'][-1])**2 + (obj['y'] - datos['y'][-1])**2)
                if dist < distancia_minima:
                    match_id = obj_id
                    distancia_minima = dist
            
            if match_id is None:
                # Objeto Nuevo
                match_id = self.next_id
                self.next_id += 1
                nuevos_historiales[match_id] = {
                    'x': deque([obj['x']], maxlen=self.ventana_promedio),
                    'y': deque([obj['y']], maxlen=10), # Sugiero 10 para respuesta rápida
                    'ang': deque([obj['ang']], maxlen=10),
                    'box': deque([obj['box']], maxlen=10)
                }
            else:
                # Objeto Existente: Recuperamos el deque y añadimos el nuevo dato
                nuevos_historiales[match_id] = self.objetos_historial[match_id]
                nuevos_historiales[match_id]['x'].append(obj['x'])
                nuevos_historiales[match_id]['y'].append(obj['y'])
                nuevos_historiales[match_id]['ang'].append(obj['ang'])
                nuevos_historiales[match_id]['box'].append(obj['box'])

            # 3. Cálculo de Promedios Estables
            cx_estable = np.mean(nuevos_historiales[match_id]['x'])
            cy_estable = np.mean(nuevos_historiales[match_id]['y'])
            ang_estable = np.mean(nuevos_historiales[match_id]['ang'])
            box_estable = np.intp(np.mean(list(nuevos_historiales[match_id]['box']), axis=0))

            # 4. Conversión de Unidades (Usando los promedios)
            #Pilexes desde el origen definido (self.origen_X, self.origen_Y)
            dx_pixeles = int(cx_estable) - self.origen_x
            dy_pixeles = int(cy_estable) - self.origen_y

            # Convertir a milímetros reales
            distancia_x_mm = dx_pixeles * self.px_to_mm
            distancia_y_mm = dy_pixeles * self.px_to_mm

            # 5. Obtener Color
            color = self.detectar_color(frame, obj['cnt'])

            # 6. Emparejamiento con IA
            nombre_fruta = "desconocido"
            distancia_min = DISTANCIA_CENTROS # Radio de búsqueda en píxeles

            for det in self.ultima_lista_ia:
                ix, iy = det["centro"]
                # Distancia Euclidiana entre tu centroide y el de la IA
                dist = ((cx_estable - ix)**2 + (cy_estable - iy)**2)**0.5
                if dist < distancia_min:
                    nombre_fruta = det["nombre"]
                    distancia_min = dist # Nos quedamos con el más cercano

            # 7. Dibujo de resultados
            cv2.drawContours(frame, [box_estable], 0, (0, 255, 0), 2)
            cv2.circle(frame, (int(cx_estable), int(cy_estable)), 3, (255, 0, 0), -1)
            cv2.putText(frame, nombre_fruta, (int(cx_estable) - 20, int(cy_estable) - 40), 
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            
            # 8. Preparar datos para enviar a HMI y PLC
            datos={"X_mm": distancia_x_mm, "Y_mm": distancia_y_mm, "Angulo": ang_estable, "Color": color, "Tipo": nombre_fruta}

        # Final del proceso: Limpiar historial global
        self.objetos_historial = nuevos_historiales

        
        ##------------------------------------------------------------------ DEBUG
        # --- CREAR EL MOSAICO ---
        # Convertimos todo a 3 canales (BGR) para poder concatenar
        capa1 = frame_inicial # Original
        capa2 = ganancias # Corregido
        capa3 = cv2.cvtColor(v_canal, cv2.COLOR_GRAY2BGR) # Canal V
        capa4 = cv2.cvtColor(blurred, cv2.COLOR_GRAY2BGR) # Blur
        capa5 = cv2.cvtColor(canny, cv2.COLOR_GRAY2BGR) # Bordes
        capa6 = cv2.cvtColor(dilate, cv2.COLOR_GRAY2BGR) # Bordes
        capa7 = cv2.cvtColor(erode, cv2.COLOR_GRAY2BGR) # Bordes
        capa8 = frame # Final


        # Redimensionamos cada una (ej. 320x240 si tu cámara es 640x480)
        h, w = frame.shape[:2]
        nw, nh = w // 2, h // 2
        
        r1 = cv2.resize(capa1, (nw, nh))
        r2 = cv2.resize(capa2, (nw, nh))
        r3 = cv2.resize(capa3, (nw, nh))
        r4 = cv2.resize(capa4, (nw, nh))
        r5 = cv2.resize(capa5, (nw, nh))
        r6 = cv2.resize(capa6, (nw, nh))
        r7 = cv2.resize(capa7, (nw, nh))
        r8 = cv2.resize(capa8, (nw, nh))

        # Pegamos las filas
        fila_1 = np.hstack((r1, r2))
        fila_2 = np.hstack((r3, r4))
        fila_3 = np.hstack((r5, r6))
        fila_4 = np.hstack((r7, r8))

        # Unimos las filas verticalmente
        mosaico = np.vstack((fila_1, fila_2, fila_3, fila_4))
        ##------------------------------------------------------------------
        
        #Enviamos mosaico para ver el pipeline y debuguear
        return mosaico, datos
        #return frame, datos

    def restart_camera(self, new_cam_id):
        self.running = False # Detenemos el bucle actual
        self.wait()      # Esperamos a que el sistema libere la cámara anterior
        self.cap_index = new_cam_id # Guardamos el nuevo ID
        self.running = True  # Reactivamos
        self.start()         # Reiniciamos el hilo

    #Ejecucion en paralelo al hilo principal
    def run(self):
        try:
            cap = cv2.VideoCapture(self.cap_index)

            # Verificamos si la cámara realmente abrió
            if not cap.isOpened():
                print(f"ERROR: No se pudo acceder a la cámara {self.cap_index}")
                return # Sale del run y el hilo termina (la pantalla seguirá negra)
            
            while self.running:
                ret, frame = cap.read()
                if not ret: break # Si la cámara falla, salimos del bucle

                # 1. Avisamos a la IA que hay un frame nuevo
                self.enviar_a_ia_signal.emit(frame)

                # 2. Tu procesamiento de ingeniería
                frame_procesado, datos = self.procesar(frame)
                
                self.change_pixmap_signal.emit(frame_procesado)
                self.data_signal.emit(datos)

            cap.release() # Liberamos la cámara al finalizar

        except Exception as e: 
            print(f"Error al acceder a la cámara: {e}")

# --- CLASE PARA EL HILO DE MODBUS ---
class ModbusThread(QThread):
    #Señal para avisar a la interfaz si la conexión tuvo éxito o no
    connection_result = pyqtSignal(bool)

    def __init__(self):
        super().__init__()
        self.client = None
        self.ip = "127.0.0.1"
        self.port = 502
        self.is_running = False

        self.n_muestras = PROMEDIO_MEDIDAS_MODBUS  # Define qué tan "lento" quieres que reaccione. 5-10 suele ser ideal.
        self.historial_x = deque(maxlen=self.n_muestras)
        self.historial_y = deque(maxlen=self.n_muestras)
        self.historial_ang = deque(maxlen=self.n_muestras)

    def set_config(self, ip, port):
        self.ip = ip
        self.port = port

    def run(self):
        try:
            self.client = ModbusTcpClient(self.ip, port=self.port)
            if self.client.connect():
                self.is_running = True
                self.connection_result.emit(True)
                while self.is_running:
                    # El hilo se mantiene vivo esperando comandos
                    self.msleep(100) 
            else:
                self.connection_result.emit(False)
        except Exception as e:
            print(f"Error en hilo Modbus: {e}")
            self.connection_result.emit(False)

    @pyqtSlot(dict)
    def enviar_datos(self, datos):
        """Esta función recibe los datos de la visión y los manda al PLC"""
        if self.is_running and self.client.is_socket_open():
            try:
                # 1. Agregar nuevos valores al historial
                self.historial_x.append(datos.get('X_mm', 0))
                self.historial_y.append(datos.get('Y_mm', 0))
                self.historial_ang.append(datos.get('Angulo', 0))

                # 2. Calcular el promedio de lo que hay en el historial
                # Usamos len() para evitar división por cero en las primeras lecturas
                x_prom = sum(self.historial_x) / len(self.historial_x)
                y_prom = sum(self.historial_y) / len(self.historial_y)
                ang_prom = sum(self.historial_ang) / len(self.historial_ang)

                # Función para sanitizar: 
                # 1. Convierte a int. 
                # 2. Asegura que sea >= 0 (evita negativos).
                # 3. Asegura que sea <= 65535 (evita desbordamientos).
                def sanitizar(val):
                    return max(0, min(int(val*100), 65535))
                
                # Escalamos para no perder decimales (ej: 10.55mm -> 1055)
                x = sanitizar(x_prom)
                y = sanitizar(y_prom)
                ang = sanitizar(ang_prom)
                
                # Modbus NO entiende strings, así que convertimos el item a un ID
                color_raw = datos.get('Color', 'Desconocido')
                tipo_raw = datos.get('Tipo', 'Desconocido')
                # Diccionario de conversión
                #Mapeo de colores
                mapeo_colores = {'Desconocido': 0, 'Blanco/Gris': 1, 'Negro': 2,
                                  'Rojo': 3, 'Naranja': 4, 'Amarillo': 5, 'Verde': 6,
                                   'Azul': 7, 'Violeta': 8 }
                color_id = mapeo_colores.get(color_raw, 0)
                #Mapeo de frutas
                mapeo_tipos = {'Desconocido': 0, 'chayote': 1, 'manzana': 2,
                                  'tomate': 3, 'zanahoria': 4 }
                tipo_id = mapeo_tipos.get(tipo_raw, 0)

                # Escribimos en los registros 0, 1, 2, 3 y 4
                self.client.write_registers(0, [x, y, ang, color_id, tipo_id])
                #print("Datos enviados al PLC:")
                #print(f"  X: {x}, Y: {y}, Ang: {ang}, Color ID: {color_id}, Tipo ID: {tipo_id}")

            except Exception as e:
                print(f"Fallo al escribir en PLC: {e}")

    def stop(self):
        self.is_running = False
        if self.client:
            self.client.close()
        self.quit()

# --- CLASE PARA EL HILO DE IA ---
class IAThread(QThread):
    # Definimos la señal que enviará la lista de detecciones
    # Cada elemento de la lista será: {'nombre': str, 'centro': (x, y)}
    deteccion_ia_signal = pyqtSignal(list) 

    def __init__(self):
        super().__init__()
        # Cargamos el modelo
        self.model = YOLO(MODELO_YOLO)
        self.frame_actual = None

    def procesar_frame(self, frame):
        """Método que recibe el frame desde el hilo de video"""
        if not self.isRunning():
            self.frame_actual = frame.copy() # Usamos .copy() para evitar conflictos de memoria
            self.start()

    def run(self):
        """Inferencia asíncrona"""
        # Aplicamos el filtro de confianza de 0.8 
        results = self.model.predict(self.frame_actual, conf=0.8, verbose=False)
        lista_detecciones = []

        if results and len(results[0].boxes) > 0:
            for box in results[0].boxes:
                # Obtener nombre de la clase
                cls = int(box.cls[0])
                nombre = self.model.names[cls]
                
                # Obtener coordenadas del centro (x_centro, y_centro)
                # xywh devuelve [x_center, y_center, width, height]
                x_c, y_c, _, _ = box.xywh[0].tolist()
                
                lista_detecciones.append({
                    "nombre": nombre, 
                    "centro": (int(x_c), int(y_c))
                })
        
        self.deteccion_ia_signal.emit(lista_detecciones)

# --- CLASE PRINCIPAL DEL HMI ---
class RobotHMI(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowIcon(QIcon("ojo.jpg"))
        self.setWindowTitle("HMI Control de Calidad - Robot Vision")
        self.setGeometry(100, 100, 1000, 700) #(x, y, ancho, alto)
        self.setStyleSheet("background-color: #1e1e1e; color: white;")

        # Layouts
        self.central_widget = QWidget()
        self.setCentralWidget(self.central_widget)
        self.main_layout = QHBoxLayout(self.central_widget)

        # 1. Panel de Video (Izquierda)
        self.video_label = QLabel()
        self.video_label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.video_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.video_label.setMinimumSize(100, 75)
        self.main_layout.addWidget(self.video_label, stretch=2)

        # 2. Panel de Control (Derecha)
        self.control_panel = QVBoxLayout()

        # Separador visual
