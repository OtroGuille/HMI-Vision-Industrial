    def update_image(self, cv_img):
        
        """Convierte imagen de OpenCV a formato de PyQt"""
        rgb_image = cv2.cvtColor(cv_img, cv2.COLOR_BGR2RGB)
        h, w, ch = rgb_image.shape
        bytes_per_line = ch * w
        qt_img = QImage(rgb_image.data, w, h, bytes_per_line, QImage.Format.Format_RGB888)
        p = qt_img.scaled(self.video_label.size(), 
                          Qt.AspectRatioMode.KeepAspectRatio, 
                          Qt.TransformationMode.SmoothTransformation)
        self.video_label.setPixmap(QPixmap.fromImage(p))

    def cambiar_camara(self):
        #Tomamos el nuevo ID de cámara del SpinBox
        new_cam_id = self.spin_cam.value()
        #Reiniamos pantalla camara
        self.hilo_video.restart_camera(new_cam_id)

    def actualizar_telemetria(self, datos):
        #Actualizar las etiquetas con los nuevos datos
        self.lbl_x.setText(f"X: {datos['X_mm']:.1f} mm")
        self.lbl_y.setText(f"Y: {datos['Y_mm']:.1f} mm")
        self.lbl_angulo.setText(f"Θ: {datos['Angulo']:.1f}°")
        self.lbl_color.setText(f"COLOR: {datos['Color']}")
        self.lbl_tipo.setText(f"TIPO: {datos['Tipo']}")

    def actualizar_factor(self):
        nuevo_factor = self.spin_factor.value()
        self.hilo_video.set_calibration(nuevo_factor)

    def actualizar_roi(self):
        ancho = self.sld_roi_w.value()
        alto = self.sld_roi_h.value()
        
        # Enviamos los nuevos tamaños al hilo directamente
        self.hilo_video.set_roi_size(ancho, alto)

    def actualizar_origen(self):
        pos_x = self.sld_o_posx.value()
        pos_y = self.sld_o_posy.value()

        # Enviamos los nuevos orígenes al hilo directamente
        self.hilo_video.set_origin(pos_x, pos_y)

    def toggle_modbus(self):
        if self.btn_conectar.isChecked():
            # 1. Leer valores de los QLineEdits
            ip_plc = self.txt_ip.text()
            try:
                puerto_plc = int(self.txt_puerto.text())
            except ValueError:
                self.lbl_status.setText("Puerto Inválido")
                return
            
            # 2. Configurar y arrancar
            self.hilo_modbus.set_config(ip_plc, puerto_plc)
            self.hilo_modbus.start()
            
            # 3. UI Feedback
            self.lbl_status.setText("Conectando...")
            self.lbl_status.setStyleSheet("background-color: orange; color: white; border-radius: 5px;")
        else:
            self.hilo_modbus.stop()
            self.lbl_status.setText("Desconectado")
            self.lbl_status.setStyleSheet("background-color: gray; color: white; border-radius: 5px;")
            self.btn_conectar.setText("Conectar PLC")

    def finalizar_conexion_modbus(self, exito):
        if exito:
            self.lbl_status.setText("ONLINE")
            self.lbl_status.setStyleSheet("background-color: green; color: white; border-radius: 5px;")
            self.btn_conectar.setText("Desconectar")
        else:
            self.lbl_status.setText("ERROR")
            self.lbl_status.setStyleSheet("background-color: red; color: white; border-radius: 5px;")
            self.btn_conectar.setChecked(False)
            self.btn_conectar.setText("Reintentar")

