            'capa1', 'capa2', 'capa3', 'capa4', 'capa5', 'capa6', 'capa7', 'capa8',
            'r1', 'r2', 'r3', 'r4', 'r5', 'r6', 'r7', 'r8', 'fila_1', 'fila_2', 'fila_3', 'fila_4'
        ]
        
        for var in variables_a_borrar:
            if var in locals():
                del locals()[var]

        # 2. Forzamos al recolector de basura a liberar la RAM de inmediato en este ciclo
        # gc.collect() # OPTIMIZACIÓN: Eliminada llamada forzada al GC para evitar micro-congelamientos (stop-the-world)

        return frame, datos

    def restart_camera(self, new_cam_id):
        self.running = False # Detenemos el bucle actual
        self.wait()      # Esperamos a que el sistema libere la cámara anterior
        self.cap_index = new_cam_id # Guardamos el nuevo ID
        self.running = True  # Reactivamos
        self.start()         # Reiniciamos el hilo

    #Ejecucion en paralelo al hilo principal
    def run(self):
        try:
            self.camara_mars = CamaraMarsIndustrial()

            # Verificamos si la cámara realmente abrió
            if not self.camara_mars.inicializar():
                print(f"ERROR: No se pudo acceder a la cámara")
                return # Sale del run y el hilo termina (la pantalla seguirá negra)
            
            # Contador para saltar frames si la cámara es demasiado rápida (Ej: procesar 1 de cada 3 frames)
            contador_frames = 0

            while self.running:
                ret, frame_raw = self.camara_mars.obtener_frame()
                if not ret: break # Si la cámara falla, salimos del bucle

                contador_frames += 1
                if contador_frames % 2 != 0:  # <─── Descarta el 50% de los frames entrantes de la Mars
                    del frame_raw           # Libera inmediatamente el frame duplicado
                    continue

                frame = cv2.resize(frame_raw, (640, 480), interpolation=cv2.INTER_AREA)
                del frame_raw # Liberamos el frame original de la cámara para no saturar la memoria

                # 1. Avisamos a la IA que hay un frame nuevo
                self.enviar_a_ia_signal.emit(frame)

                # 2. Tu procesamiento de ingeniería
                frame_procesado, datos = self.procesar(frame)
                
                self.change_pixmap_signal.emit(frame_procesado)
                self.data_signal.emit(datos)

                del frame
                del frame_procesado

            self.camara_mars.liberar() # Liberamos la cámara al finalizar

        except Exception as e: 
            print(f"Error al acceder a la cámara: {e}")

# --- CLASE PARA EL HILO DE MODBUS ---
class ModbusThread(QThread):
    # Señal para avisar a la interfaz si la conexión tuvo éxito o no
    connection_result = pyqtSignal(bool)
    
    # SEÑAL PARA EL HMI: Emite la posición actual en tiempo real hacia las etiquetas que creaste
    posicion_actual_hmi_signal = pyqtSignal(dict)

    def __init__(self):
        super().__init__()
        self.client = None
        self.ip = "192.168.2.17"
        self.port = 502
        self.is_running = False

        # Historial para el suavizado del cálculo de la cámara
        # Nota: Asegúrate de que PROMEDIO_MEDIDAS_MODBUS esté definido en tus constantes arriba
        self.n_muestras = PROMEDIO_MEDIDAS_MODBUS  
        self.historial_x = deque(maxlen=self.n_muestras)
        self.historial_y = deque(maxlen=self.n_muestras)
        self.historial_z = deque(maxlen=self.n_muestras)

        # ─────────────────────────────────────────────
        # DIRECCIONES DE MEMORIA (Fórmula SZGH: Registro = 2 * GV)
        # ─────────────────────────────────────────────
        # LECTURA: Coordenadas actuales reales del robot (GV206, GV207, GV208)
        self.REG_LEER_POS_START = 412  # 2 * 206 = Registro 412 (Lee X, Y, Z de una sola ráfaga)
        
        # ESCRITURA: Variables de destino absoluto para tu bucle del robot (GV1, GV2, GV3)
        self.REG_WRITE_X = 2  # GV1 = Registros 2 y 3
        self.REG_WRITE_Y = 4  # GV2 = Registros 4 y 5
        self.REG_WRITE_Z = 6  # GV3 = Registros 6 y 7

        # Memoria interna del hilo para guardar el último punto mecánico conocido
        self.robot_x_actual = 0.0
        self.robot_y_actual = 0.0
        self.robot_z_actual = 0.0

        self.ultimo_envio_time = 0.0  # Registra el tiempo del último paquete enviado

    def set_config(self, ip, port):
        self.ip = ip
        self.port = port
    
    def run(self):
        """Bucle cíclico que lee la posición física del robot y actualiza el HMI"""
        try:
            # Conexión limpia usando pyModbusTCP
            self.client = ModbusClient(host=self.ip, port=self.port, unit_id=1, auto_open=True)
            if self.client.open():
                self.is_running = True
                self.connection_result.emit(True)
                
                while self.is_running:
                    # Leemos 6 registros consecutivos de retención (Holding Registers)
                    # Cada coordenada Float de 32 bits ocupa 2 registros. (3 variables * 2 = 6 regs)
                    regs = self.client.read_holding_registers(self.REG_LEER_POS_START, 6)
                    
                    if regs and len(regs) == 6:
                        # Desempaquetar X (GV206)
                        raw_x = struct.pack('<HH', regs[0], regs[1])
                        self.robot_x_actual = struct.unpack('<f', raw_x)[0]
                        
                        # Desempaquetar Y (GV207)
                        raw_y = struct.pack('<HH', regs[2], regs[3])
                        self.robot_y_actual = struct.unpack('<f', raw_y)[0]
                        
                        # Desempaquetar Z (GV208)
                        raw_z = struct.pack('<HH', regs[4], regs[5])
                        self.robot_z_actual = struct.unpack('<f', raw_z)[0]

                        # Preparamos el diccionario limpio para la interfaz gráfica
                        dict_pos = {
                            'X': round(self.robot_x_actual, 2),
                            'Y': round(self.robot_y_actual, 2),
                            'Z': round(self.robot_z_actual, 2)
                        }
                        # Disparamos los datos hacia la HMI
                        self.posicion_actual_hmi_signal.emit(dict_pos)
                    
                    self.msleep(100)  # Muestreo a 10Hz, óptimo para no saturar la CPU del SZGH
            else:
                self.connection_result.emit(False)
        except Exception as e:
            print(f"Error en bucle de telemetría Modbus: {e}")
            self.connection_result.emit(False)
    
    def _convertir_a_palabras_float(self, valor):
        """Convierte un float de Python a dos palabras de 16 bits (Low word primero)"""
        raw = struct.pack('<f', float(valor))
        low  = struct.unpack('<H', raw[0:2])[0]
        high = struct.unpack('<H', raw[2:4])[0]
        return [low, high]
    
    @pyqtSlot(dict)
    def enviar_datos(self, datos):
        """Recibe el desfasaje de la cámara, efectúa la suma y escribe el destino absoluto"""
        if self.is_running and self.client.is_open:
            try:
                #Borra el historial para pruebas manuales
                #self.historial_x.clear()
                #self.historial_y.clear()
                #self.historial_z.clear()
                #Desactivar cuando sea el caso real

                # ─── CONTROL DE VELOCIDAD (THROTTLE) ───
                tiempo_actual = time.time()
                # 0.100 segundos significa que solo se permite enviar datos cada 100ms (10 veces por segundo)
                if (tiempo_actual - self.ultimo_envio_time) < 0.100:
                    return  # Ignora este frame y limpia la cola de PyQt de inmediato


                # Extraemos el error en mm calculado por tu algoritmo de visión en el ROI
                desfase_x = datos.get('X_mm', 0.0)
                desfase_y = datos.get('Y_mm', 0.0)
                desfase_z = datos.get('Z_mm', 0.0)  

                # Si es un frame vacío sin detecciones reales, no enviamos comandos de movimiento
                if desfase_x == 0.0 and desfase_y == 0.0 and desfase_z == 0.0:
                    return

                # FÓRMULA DE CONTROL: Destino Absoluto = Posición Física Actual + Desfase de la Fruta
                #x_destino = self.robot_x_actual + desfase_x
                #y_destino = self.robot_y_actual + desfase_y
                #z_destino = self.robot_z_actual

                k=0.3

                x_destino = 716.7
                y_destino = 151.79+desfase_x*k
                #z_destino = 209.5 + desfase_z 
                z_destino = 300-desfase_y*k

                self.historial_x.clear()
                self.historial_y.clear()
                self.historial_z.clear()

                # Aplicamos el filtro de promedio móvil para suavizar picos de ruido
                self.historial_x.append(x_destino)
                self.historial_y.append(y_destino)
                self.historial_z.append(z_destino)

                x_prom = sum(self.historial_x) / len(self.historial_x)
                y_prom = sum(self.historial_y) / len(self.historial_y)
                z_prom = sum(self.historial_z) / len(self.historial_z)

                # Convertimos las coordenadas finales a pares de registros Modbus (Float 32bit)
                palabras_x = self._convertir_a_palabras_float(x_prom)
                palabras_y = self._convertir_a_palabras_float(y_prom)
                palabras_z = self._convertir_a_palabras_float(z_prom)

                # ─────────────────────────────────────────────────────────────
                # ESCRITURA FORZADA CON PAUSAS DE ESTABILIZACIÓN
                # ─────────────────────────────────────────────────────────────
                sleep_time=10

                ok_x = self.client.write_multiple_registers(self.REG_WRITE_X, palabras_x)
                self.msleep(sleep_time)  # Pausa de 30ms para que el procesador del SZGH procese el registro
                
                ok_y = self.client.write_multiple_registers(self.REG_WRITE_Y, palabras_y)
                self.msleep(sleep_time)
                
                ok_z = self.client.write_multiple_registers(self.REG_WRITE_Z, palabras_z)
                self.msleep(sleep_time)

                # ─── REGISTRO DE TIEMPO EXITOSO ───
                self.ultimo_envio_time = tiempo_actual

                # Verificación de transmisión en la terminal
                #print(f"[MODBUS TX] Éxito -> X: {ok_x} | Y: {ok_y} | Z: {ok_z}")
                #print(f" -> Enviado a GV1-GV3 -> X: {x_prom:.2f} | Y: {y_prom:.2f} | Z: {z_prom:.2f}")

                # Log de telemetría para supervisión en tiempo real
                print(f"[SEGUIMIENTO] -> Desfase detectados: ΔX: {desfase_x:.1f}mm | ΔY: {desfase_y:.1f}mm")
                print(f"              -> Trayectoria calculada: X: {x_prom:.2f} | Y: {y_prom:.2f} | Z: {z_prom:.2f}")

            except Exception as e:
                print(f"Error en procesamiento analítico de coordenadas: {e}")

    def stop(self):
        self.is_running = False
        if self.client:
            self.client.close()
        self.quit()

# --- CLASE PARA EL HILO DE IA ---
class IAThread(QThread):
    # Definimos la señal que enviará la lista de detecciones
    # Cada elemento de la lista será: {'nombre': str, 'centro': (x, y)}
    deteccion_ia_signal = pyqtSignal(list)

    def __init__(self, frame_queue):
        super().__init__()
        # Cargamos el modelo
        self.model = YOLO(MODELO_YOLO)
        self.frame_queue = frame_queue # Recibimos la cola de frames
        self.running = True

    def run(self):
        """Bucle de inferencia continua (Consumer)"""
        print("[IA Thread] Iniciando bucle de inferencia...")
        while self.running:
            try:
                # Esperar por un frame en la cola (timeout para permitir salida limpia)
                frame = self.frame_queue.get(timeout=1.0)

                # Inferencia
                results = self.model.predict(frame, conf=0.8, verbose=False)
                lista_detecciones = []

                if results and len(results[0].boxes) > 0:
                    for box in results[0].boxes:
                        cls = int(box.cls[0])
                        nombre = self.model.names[cls]
                        x_c, y_c, _, _ = box.xywh[0].tolist()
                        lista_detecciones.append({
                            "nombre": nombre,
                            "centro": (int(x_c), int(y_c))
                        })

                self.deteccion_ia_signal.emit(lista_detecciones)
                self.frame_queue.task_done()

            except queue.Empty:
                continue
            except Exception as e:
                print(f"Error en IAThread: {e}")

    def stop(self):
        self.running = False
        self.quit()
        self.wait()

