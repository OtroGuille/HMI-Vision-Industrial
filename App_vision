    def update_image(self, cv_img):

        
        """Convierte imagen de OpenCV a formato de PyQt de forma eficiente sin fugas"""
        try:
            if cv_img is None:
                return

            # 1. Usamos Format_BGR888 directamente sobre cv_img.data
            # Así nos ahorramos el cv2.cvtColor() que creaba una matriz extra en RAM
            h, w, ch = cv_img.shape
            bytes_per_line = ch * w
            qt_img = QImage(cv_img.data, w, h, bytes_per_line, QImage.Format.Format_BGR888)
            
            # 2. Escalamos la imagen al tamaño del label
            p = qt_img.scaled(self.video_label.size(), 
                              Qt.AspectRatioMode.KeepAspectRatio, 
                              Qt.TransformationMode.SmoothTransformation)
            
            # 3. Asignamos el Pixmap a la interfaz
            self.video_label.setPixmap(QPixmap.fromImage(p))

            # 4. LIMPIEZA EXPLÍCITA: Rompemos las referencias del frame en este ciclo
            del qt_img
            del p
            
        except Exception as e:
            print(f"Error actualizando la imagen en el QLabel: {e}")

